{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "devCommand": "npm run start",
    "redirects": [
        { "source": "/", "destination": "/notes", "permanent": false }
    ],
    "rewrites": [
        { "source": "/(.*)", "destination": "/404" }
    ]
}
